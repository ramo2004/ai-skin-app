{
  "compilerOptions": {
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-native",
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "App.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "constants/**/*.ts",
    "env.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "components/**",
    "hooks/**",
    "scripts/**"
  ],
  "extends": "expo/tsconfig.base"
}
